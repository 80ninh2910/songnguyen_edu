generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERADMIN
  TUTOR
  CENTER_TEACHER
}

enum AdminRole {
  ADMIN
  SUPERADMIN
}

enum TutorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TutorType {
  GIA_SU_TU_DO
  GIA_SU_DAO_TAO
  GIAO_VIEN_TRUNG_TAM
  ANY
}

enum RequestType {
  GIA_SU_TU_DO
  GIA_SU_DAO_TAO
  TRUNG_TAM
}

enum ClassType {
  LOP_GIA_SU_TU_DO
  LOP_GIA_SU_DAO_TAO
  LOP_TRUNG_TAM
}

enum CenterTeacherStatus {
  ACTIVE
  INACTIVE
}

enum ClassStatus {
  OPEN
  ASSIGNED
  CLOSED
}

enum RequestStatus {
  PENDING
  CONVERTED
  REJECTED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum SettingCategory {
  SEO
  PRICING
  LANDING_PAGE
  BANKING
  SYSTEM
}

model Admin {
  id                String         @id @default(uuid())
  email             String         @unique
  fullName          String         @map("full_name")
  passwordHash      String         @map("password_hash")
  role              AdminRole      @default(ADMIN)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  approvedTutors    Tutor[]        @relation("TutorApprovedBy")
  processedRequests ClassRequest[] @relation("RequestProcessedBy")
  createdClasses    Class[]        @relation("ClassCreatedBy")
  assignedClasses   ClassAssignment[]
  reviewedPayments  Payment[]      @relation("PaymentReviewedBy")
  updatedSettings   SystemSetting[] @relation("SettingUpdatedBy")
  createdCenterTeachers CenterTeacher[] @relation("CenterTeacherCreatedBy")

  @@map("admins")
}

model Tutor {
  id             String      @id @default(uuid())
  email          String      @unique
  phone          String?
  fullName       String      @map("full_name")
  passwordHash   String?     @map("password_hash")
  tutorType      TutorType   @default(GIA_SU_TU_DO) @map("tutor_type")
  status         TutorStatus @default(PENDING)
  rejectReason   String?     @map("reject_reason")
  subjects       String[]    @default([])
  districts      String[]    @default([])
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  approvedAt     DateTime?   @map("approved_at")
  approvedById   String?     @map("approved_by_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  approvedBy     Admin?      @relation("TutorApprovedBy", fields: [approvedById], references: [id])
  applications   ClassApplication[]
  assignments    ClassAssignment[]
  payments       Payment[]
  sessions       ClassSession[]
  feedbacks      SessionFeedback[]

  documents      TutorDocument[]

  @@index([status])
  @@index([phone])
  @@index([subjects], type: Gin)
  @@map("tutors")
}

model TutorDocument {
  id        String   @id @default(uuid())
  tutorId   String   @map("tutor_id")
  type      String                        // "CCCD" | "DEGREE" | "CERTIFICATE" | "OTHER"
  url       String
  createdAt DateTime @default(now()) @map("created_at")

  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId])
  @@map("tutor_documents")
}

model CenterTeacher {
  id          String              @id @default(uuid())
  email       String              @unique
  phone       String?
  fullName    String              @map("full_name")
  status      CenterTeacherStatus @default(ACTIVE)
  subjects    String[]            @default([])
  districts   String[]            @default([])
  createdById String?             @map("created_by_id")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  createdBy   Admin?              @relation("CenterTeacherCreatedBy", fields: [createdById], references: [id])
  classes     Class[]

  @@index([status])
  @@index([subjects], type: Gin)
  @@map("center_teachers")
}

model ClassRequest {
  id            String       @id @default(uuid())
  studentName   String?      @map("student_name")
  parentName    String       @map("parent_name")
  parentPhone   String       @map("parent_phone")
  parentEmail   String?      @map("parent_email")
  subject       String
  grade         String
  district      String
  budgetPerHour Int          @map("budget_per_hour")
  requestType   RequestType  @default(GIA_SU_TU_DO) @map("request_type")
  tutorType     TutorType    @default(GIA_SU_TU_DO) @map("tutor_type")
  note          String?
  status        RequestStatus @default(PENDING)
  processedAt   DateTime?     @map("processed_at")
  processedById String?       @map("processed_by_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  processedBy   Admin?        @relation("RequestProcessedBy", fields: [processedById], references: [id])
  classes       Class[]
  members       ClassMember[]

  @@index([status])
  @@index([requestType])
  @@index([tutorType])
  @@map("class_requests")
}

model Class {
  id              String           @id @default(uuid())
  title           String
  subject         String
  grade           String
  district        String
  feePerHour      Int              @map("fee_per_hour")
  classType       ClassType        @default(LOP_GIA_SU_TU_DO) @map("class_type")
  tutorType       TutorType        @default(GIA_SU_TU_DO) @map("tutor_type")
  centerTeacherId String?          @map("center_teacher_id")
  schedule        String?
  status          ClassStatus      @default(OPEN)
  sourceRequestId String?          @map("source_request_id")
  createdById     String           @map("created_by_id")
  closedAt        DateTime?        @map("closed_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  sourceRequest   ClassRequest?    @relation(fields: [sourceRequestId], references: [id])
  centerTeacher   CenterTeacher?   @relation(fields: [centerTeacherId], references: [id])
  createdBy       Admin            @relation("ClassCreatedBy", fields: [createdById], references: [id])
  applications    ClassApplication[]
  assignment      ClassAssignment?
  members         ClassMember[]
  payments        Payment[]
  sessions        ClassSession[]

  @@index([status])
  @@index([status, subject, district])
  @@index([classType])
  @@index([tutorType])
  @@map("classes")
}

model ClassApplication {
  id        String            @id @default(uuid())
  classId   String            @map("class_id")
  tutorId   String            @map("tutor_id")
  status    ApplicationStatus @default(PENDING)
  note      String?
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  class     Class             @relation(fields: [classId], references: [id], onDelete: Cascade)
  tutor     Tutor             @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([classId, tutorId])
  @@index([classId])
  @@index([tutorId])
  @@map("class_applications")
}

model ClassAssignment {
  id           String   @id @default(uuid())
  classId      String   @unique @map("class_id")
  tutorId      String   @map("tutor_id")
  assignedById String   @map("assigned_by_id")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  tutor        Tutor    @relation(fields: [tutorId], references: [id])
  assignedBy   Admin    @relation(fields: [assignedById], references: [id])

  @@index([tutorId])
  @@map("class_assignments")
}

model Payment {
  id           String        @id @default(uuid())
  tutorId      String        @map("tutor_id")
  classId      String?       @map("class_id")
  attemptCount Int           @default(1) @map("attempt_count")
  amount       Int
  billImageUrl String        @map("bill_image_url")
  status       PaymentStatus @default(PENDING)
  note         String?
  reviewedById String?       @map("reviewed_by_id")
  reviewedAt   DateTime?     @map("reviewed_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  tutor        Tutor         @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  class        Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  reviewedBy   Admin?        @relation("PaymentReviewedBy", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([classId, createdAt(sort: Desc)])
  @@index([classId, status])
  @@map("payments")
}

model ClassMember {
  id          String       @id @default(uuid())
  requestId   String?      @map("request_id")
  classId     String?      @map("class_id")
  studentName String       @map("student_name")
  studentGrade String?     @map("student_grade")
  parentName  String       @map("parent_name")
  parentPhone String       @map("parent_phone")
  parentEmail String?      @map("parent_email")
  address     String?
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  request     ClassRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  class       Class?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  feedbacks   SessionFeedback[]

  @@index([requestId])
  @@index([classId])
  @@map("class_members")
}

model ClassSession {
  id            String         @id @default(uuid())
  classId       String         @map("class_id")
  tutorId       String         @map("tutor_id")
  sessionNumber Int            @map("session_number")
  sessionDate   DateTime       @map("session_date")
  startTime     String?        @map("start_time")
  endTime       String?        @map("end_time")
  topic         String?
  notes         String?
  status        SessionStatus  @default(SCHEDULED)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  class         Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  tutor         Tutor          @relation(fields: [tutorId], references: [id])
  feedbacks     SessionFeedback[]

  @@unique([classId, sessionNumber])
  @@index([classId, sessionDate])
  @@index([tutorId, sessionDate])
  @@map("class_sessions")
}

model SessionFeedback {
  id                 String            @id @default(uuid())
  sessionId          String            @map("session_id")
  memberId           String            @map("member_id")
  tutorId            String            @map("tutor_id")
  attendance         AttendanceStatus  @default(PRESENT)
  attitudeScore      Int?              @map("attitude_score")
  comprehensionScore Int?              @map("comprehension_score")
  homeworkScore      Int?              @map("homework_score")
  strengths          String?
  weaknesses         String?
  recommendation     String?
  overallComment     String?           @map("overall_comment")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  session            ClassSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  member             ClassMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tutor              Tutor             @relation(fields: [tutorId], references: [id])

  @@unique([sessionId, memberId])
  @@index([sessionId])
  @@index([memberId])
  @@index([tutorId, createdAt(sort: Desc)])
  @@map("session_feedbacks")
}

model SystemSetting {
  id          String          @id @default(uuid())
  key         String          @unique
  category    SettingCategory @default(SYSTEM)
  value       Json
  description String?
  updatedById String          @map("updated_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  updatedBy   Admin           @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@index([category])
  @@index([updatedById])
  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String   @map("actor_id")
  actorName  String   @map("actor_name")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}
